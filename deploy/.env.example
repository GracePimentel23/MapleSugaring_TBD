# Copy to deploy/.env on the VM and fill in. deploy/.env is gitignored: secrets never go in git.
# Plain KEY=value lines, no spaces around "=" (deploy/update.sh also reads this file).

# Which stack deploy/update.sh rebuilds (paths are from the repo root).
COMPOSE_FILE=deploy/vm.compose.yml

# Database password, made up once: e.g. openssl rand -hex 24
POSTGRES_PASSWORD=

# Where people open the site (links in alert emails).
SITE_URL=http://maplesugaring02.webdev.gccis.rit.edu:3000

# Gateway bridges send readings to http://<site>:3000/api/ingest. Require a key for that
# (make per-gateway keys with: sudo docker compose -f deploy/vm.compose.yml exec worker npm run gateway-key -- GW-NAME).
REQUIRE_INGEST_KEY=true

# Sign-in. Left off, anyone who can reach the site can use every page ("View as" in the profile
# menu picks a role to preview). To turn on Google sign-in, set AUTH_PROVIDER=google and the rest;
# Google only redirects to https addresses (or localhost), so this needs HTTPS in front of the site.
#AUTH_PROVIDER=google
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#SESSION_SECRET=
#PUBLIC_URL=https://maplesugaring02.webdev.gccis.rit.edu
#ADMIN_EMAILS=
# Read-only for everyone while sign-in is off: uncomment to show the guest view only.
#DEV_ROLE=guest

# Bucket tipped alert emails through Resend (optional).
#RESEND_API_KEY=
#ALERT_EMAIL_TO=
