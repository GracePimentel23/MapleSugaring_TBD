# Copy to worker/.env for local dev (`npm run dev` loads it). On the VM, set these in the worker's
# docker compose environment instead. Never commit the real values.

# --- Google sign-in -------------------------------------------------------------------------------
# Leave AUTH_PROVIDER unset (or "off") and the API stays open, like before: no keys needed.
AUTH_PROVIDER=google

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type "Web application").
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me

# Signs the session cookie. 32+ random characters, different per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-32-plus-random-characters

# Where people open the web app. Google must have PUBLIC_URL/api/auth/google/callback registered
# as an authorized redirect URI. https URLs also get Secure cookies.
PUBLIC_URL=http://localhost:3000

# Google Workspace domains allowed to sign in (comma separated). RIT's Google accounts are @g.rit.edu.
# Both the email's domain and Google's hosted-domain (hd) claim must match, so personal Google
# accounts registered with an RIT address are refused.
ALLOWED_EMAIL_DOMAINS=g.rit.edu

# Individual addresses allowed regardless of domain (e.g. club members without RIT accounts).
ALLOWED_EMAILS=

# Made admin on every sign-in (and allowed regardless of domain). Everyone else starts as viewer;
# admins promote people with PATCH /api/users/:id {"role": "member"}.
ADMIN_EMAILS=

# How long a sign-in lasts.
SESSION_DAYS=30
