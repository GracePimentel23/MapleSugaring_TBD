# Copy to bridge.env (same folder) and fill in. bridge.env is gitignored: never commit the key.

# The API. On Vercel this is the tbd-api project's URL. Locally (npm run dev): http://localhost:4000
TBD_URL=http://localhost:4000

# The bridge key. Ask an owner for one (npm run gateway-key -- create GW-YOURNAME), or use the app's
# INGEST_KEY. Leave empty only for local dev with no keys set up.
INGEST_KEY=

# Optional: the name this gateway shows up as. A per-gateway key overrides it.
# GATEWAY_ID=GW-LAB

# Optional: the gateway's serial port. Leave unset to find it automatically.
# SERIAL_PORT=COM6

# Optional: seconds between checks for readings to send (default 1). Raising it batches readings
# into fewer requests, at the cost of delay.
# FORWARD_INTERVAL=1
